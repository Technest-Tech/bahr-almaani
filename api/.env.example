APP_NAME="Bahr Al-Maaani"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev: docker compose up -d (Postgres on host port 5434)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=bahr
DB_USERNAME=bahr
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev: Mailpit UI on http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bahr-almaaani.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend origin for CORS / Sanctum
FRONTEND_URL=http://localhost:3000

# Document engine
GOTENBERG_URL=http://127.0.0.1:3300

# Search (wired in Sprint 2)
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=local_dev_master_key

# Realtime (Reverb websockets — run `php artisan reverb:start` in dev)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=566941
REVERB_APP_KEY=tfxl9gpxruxkh5cxaaec
REVERB_APP_SECRET=f1upvwmxuoyrynyczsiu
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
