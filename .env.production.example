# ═══════════════════════════════════════════════════════════════════════════
#  بحر المعاني — متغيّرات بيئة الإنتاج
#
#  انسخ هذا الملف إلى ‎.env‎ بجوار ‎docker-compose.prod.yml‎ على الخادم:
#      cp .env.production.example .env && nano .env
#
#  كل مفتاح مكتوب أمامه ‎(إلزامي)‎ يجب ملؤه — وإلا رفض docker compose الإقلاع
#  ولم يبدأ النظام. لا تضع هذا الملف في Git أبداً.
# ═══════════════════════════════════════════════════════════════════════════

# ── الهوية والعنوان ────────────────────────────────────────────────────────
# اسم النظام كما يظهر في رسائل البريد.
APP_NAME=Bahr Al-Maaani

# (إلزامي) العنوان العام الكامل بدون شرطة في آخره. هذا العنوان يخدم الواجهة
# والـ API معاً (منفذ واحد ⇒ لا مشاكل CORS)، ويُحقن داخل بناء الواجهة.
APP_URL=https://bahr.example.com

# (إلزامي) مفتاح تشفير لارافيل. وَلِّده مرة واحدة على جهازك:
#     docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
# تغييره لاحقاً يُبطل كل الجلسات والبيانات المشفّرة.
APP_KEY=

# المنطقة الزمنية التي تُحسب بها المواعيد والتنبيهات (مصر: Africa/Cairo).
APP_TIMEZONE=Africa/Cairo

# مستوى التسجيل: warning في الإنتاج، debug مؤقتاً عند تتبّع مشكلة.
LOG_LEVEL=warning

# منفذ nginx على الخادم. اتركه 80 ما لم يكن هناك بروكسي أمامه.
HTTP_PORT=80

# ── حساب المدير الأول ──────────────────────────────────────────────────────
# يُنشأ مرة واحدة عند أول ‎db:seed‎ فقط. اضبطه قبل أول تشغيل — وإلا وُلِد الحساب
# ببيانات التطوير المعروفة. غيّر كلمة المرور من داخل النظام بعد أول دخول.
ADMIN_NAME=مدير النظام
ADMIN_EMAIL=admin@bahr.example.com
ADMIN_PASSWORD=

# ── قاعدة البيانات (PostgreSQL داخل الشبكة) ────────────────────────────────
DB_DATABASE=bahr
DB_USERNAME=bahr
# (إلزامي) كلمة مرور قوية — تُنشئ بها الحاوية القاعدة أول مرة، وتغييرها بعد
# ذلك يتطلب تغييرها داخل القاعدة أيضاً.
DB_PASSWORD=

# ── Redis (الطابور + الجلسات + الكاش) ──────────────────────────────────────
# اتركها null داخل شبكة docker المغلقة، أو ضع كلمة مرور إن عرّضت المنفذ.
REDIS_PASSWORD=null

# ── البحث (Meilisearch) ────────────────────────────────────────────────────
# (إلزامي) مفتاح رئيسي حقيقي — 32 بايت عشوائية على الأقل، وليس مفتاح التطوير:
#     openssl rand -base64 32
MEILI_MASTER_KEY=

# ── البريد الصادر (SMTP حقيقي — Mailpit للتطوير فقط) ───────────────────────
# (إلزامي) خادم SMTP لدى مزوّد حقيقي (Postmark / SES / Google Workspace…).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# القيم المقبولة هما اثنتان فقط:
#   smtp   ← للمنفذ 587 (يرفَّع الاتصال تلقائياً إلى TLS عبر STARTTLS)
#   smtps  ← للمنفذ 465 (TLS مباشر)
# أي قيمة أخرى (مثل tls أو ssl) تُفشل إرسال البريد كله.
MAIL_SCHEME=smtp
# (إلزامي) عنوان المُرسِل — يجب أن يكون مصرّحاً به في سجلات SPF/DKIM للنطاق.
MAIL_FROM_ADDRESS=no-reply@bahr.example.com

# ── البث المباشر (Reverb — الجرس والبورتال اللحظي) ─────────────────────────
# (إلزامي) بيانات تطبيق Reverb. وَلِّد قيماً جديدة للإنتاج ولا تُعِد استخدام
# قيم التطوير — المفتاح يظهر في المتصفح، أما السر فلا يغادر الخادم.
#     php artisan reverb:install   ← أو ولّد يدوياً:
#     REVERB_APP_ID=$(shuf -i 100000-999999 -n 1)
#     REVERB_APP_KEY=$(openssl rand -hex 10)
#     REVERB_APP_SECRET=$(openssl rand -hex 10)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# (إلزامي) اسم النطاق العام الذي يتصل به المتصفح — بدون ‎https://‎.
# المسار ‎/app‎ يمرّره nginx إلى حاوية reverb.
REVERB_HOST=bahr.example.com
REVERB_PORT=443
REVERB_SCHEME=https

# ملاحظة: الاتصال الداخلي (PHP ← Reverb) مضبوط في docker-compose.prod.yml
# على ‎http://reverb:8080‎ ولا يحتاج تعديلاً هنا.
